generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cadastro_livro {
  id            Int          @id @default(autoincrement())
  nome          String       @db.VarChar(255)
  nome_do_autor String       @db.VarChar(150)
  editora       String       @db.VarChar(150)
  ano           Int
  genero        String       @db.VarChar(100)
  emprestimo    emprestimo[]
  reserva       reserva[]
}

model devolucao {
  id             Int        @id @default(autoincrement())
  emprestimo_id  Int        @unique
  gestao_id      Int
  data_devolucao DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  emprestimo     emprestimo @relation(fields: [emprestimo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gestao         gestao     @relation(fields: [gestao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  multa          multa?
}

model emprestimo {
  id                      Int            @id @default(autoincrement())
  usuario_id              Int
  gestao_id               Int
  livro_id                Int
  data_emprestimo         DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  data_prevista_devolucao DateTime       @db.Date
  devolucao               devolucao?
  gestao                  gestao         @relation(fields: [gestao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cadastro_livro          cadastro_livro @relation(fields: [livro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario                 usuario        @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  renovacao               renovacao[]
}

model gestao {
  id         Int          @id @default(autoincrement())
  senha      String       @db.VarChar(255)
  nome       String       @db.VarChar(100)
  email      String       @unique @db.VarChar(150)
  devolucao  devolucao[]
  emprestimo emprestimo[]
}

model multa {
  id           Int       @id @default(autoincrement())
  devolucao_id Int       @unique
  valor        Decimal   @db.Decimal(10, 2)
  dias_atraso  Int
  status       String    @db.VarChar(20)
  devolucao    devolucao @relation(fields: [devolucao_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model perfil {
  id      Int      @id @default(autoincrement())
  senha   String   @db.VarChar(255)
  nome    String   @db.VarChar(100)
  email   String   @unique @db.VarChar(150)
  usuario usuario?
}

model renovacao {
  id                  Int        @id @default(autoincrement())
  emprestimo_id       Int
  data_renovacao      DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  nova_data_devolucao DateTime   @db.Date
  emprestimo          emprestimo @relation(fields: [emprestimo_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model reserva {
  id             Int            @id @default(autoincrement())
  usuario_id     Int
  livro_id       Int
  disponivel     Boolean        @default(false)
  data_reserva   DateTime       @default(dbgenerated("CURRENT_DATE")) @db.Date
  cadastro_livro cadastro_livro @relation(fields: [livro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario        usuario        @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model usuario {
  id         Int          @id @default(autoincrement())
  perfil_id  Int          @unique
  emprestimo emprestimo[]
  reserva    reserva[]
  perfil     perfil       @relation(fields: [perfil_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

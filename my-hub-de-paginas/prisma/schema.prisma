generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model cadastro_livro {
  id            Int    @id @default(autoincrement())
  nome          String @db.VarChar(255)
  nome_do_autor String @db.VarChar(150)
  editora       String @db.VarChar(150)
  ano           Int
  genero        String @db.VarChar(100)
}
